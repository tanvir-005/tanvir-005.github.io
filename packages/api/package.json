{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply portfolio --local",
    "db:migrate": "wrangler d1 migrations apply portfolio --remote",
    "db:seed:local": "wrangler d1 execute portfolio --local --file=seed.sql",
    "db:seed": "wrangler d1 execute portfolio --remote --file=seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}

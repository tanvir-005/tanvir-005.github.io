---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="wrap page">
    <header class="page-head">
      <h1>Page not found</h1>
      <p class="lead">That address does not lead anywhere. Go to the <a href="/">home page</a>, or press Ctrl K to jump to a page.</p>
    </header>
  </div>
</Base>

---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource/ibm-plex-sans/400.css'
import '@fontsource/ibm-plex-sans/500.css'
import '@fontsource/ibm-plex-sans/600.css'
import '@fontsource/ibm-plex-mono/400.css'
import '../styles/global.css'
import { profile, cv, byType, posts, COLLECTIONS, hrefFor, truncate } from '../lib/content'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  jsonLd?: object[]
  noindex?: boolean
  published?: string
  modified?: string
}
const { title, description, image, type = 'website', jsonLd = [], noindex = false, published, modified } = Astro.props

const site = Astro.site!.toString().replace(/\/$/, '')
const path = Astro.url.pathname
const canonical = site + path
const fullTitle = title ? `${title} | ${profile.shortName || profile.name}` : `${profile.name}, ${profile.headline}`
const desc = truncate(description || profile.description || '')
const abs = (u: string) => (u.startsWith('http') ? u : site + u)
const ogImage = image ? abs(image) : profile.image ? abs(profile.image) : ''
const api = import.meta.env.PUBLIC_API_URL || ''

const showCollections = ['projects', 'contests']
const nav = [
  ...showCollections.filter((k) => byType(COLLECTIONS[k].type).length).map((k) => ({ href: `/${k}/`, label: COLLECTIONS[k].title })),
  ...(posts.length ? [{ href: '/blog/', label: 'Blog' }] : []),
  { href: '/#contact', label: 'Contact' }
]
const palette = [
  { t: 'Home', h: '/' },
  ...nav.map((n) => ({ t: n.label, h: n.href })),
  { t: 'Skills', h: '/#skills', k: 'Home' },
  { t: 'Education and leadership', h: '/#background', k: 'Home' },
  ...(cv ? [{ t: 'Download CV', h: cv.url, k: 'PDF' }] : []),
  ...byType('project').filter((p) => hrefFor('projects', p)).map((p) => ({ t: p.title, h: `/projects/${p.slug}/`, k: 'Project' })),
  ...posts.map((p) => ({ t: p.title, h: `/blog/${p.slug}/`, k: 'Post' }))
]
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {posts.length > 0 && <link rel="alternate" type="application/rss+xml" title={`${profile.name}: blog`} href="/rss.xml" />}

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${profile.name}, home`}><i aria-hidden="true"></i>{profile.shortName || profile.name}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a class="link" href={n.href} aria-current={path.startsWith(n.href) && n.href !== '/#contact' ? 'page' : undefined}>{n.label}</a>)}
          {cv && <a class="link hide-sm" href={cv.url} data-track="/cv.pdf">CV</a>}
          <button class="icon-btn" id="cmdk-open" type="button" aria-label="Open site menu and search">
            <span class="hide-sm">Search</span><span class="only-sm">Menu</span>
            <kbd class="hide-sm">Ctrl K</kbd>
          </button>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch between light and dark theme">
            <svg class="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} {profile.name}. {profile.footer}</p>
        <ul>
          {profile.github && <li><a href={profile.github} rel="me noopener">GitHub</a></li>}
          {profile.linkedin && <li><a href={profile.linkedin} rel="me noopener">LinkedIn</a></li>}
          {posts.length > 0 && <li><a href="/rss.xml">RSS</a></li>}
        </ul>
      </div>
    </footer>

    <dialog id="cmdk" aria-label="Search the site">
      <input id="cmdk-input" type="text" placeholder="Jump to a page, project or post" autocomplete="off" aria-label="Search" />
      <ul id="cmdk-list"></ul>
    </dialog>
    <script type="application/json" id="cmdk-data" set:html={JSON.stringify(palette)} />

    {api && (
      <script is:inline define:vars={{ api }}>
        (function () {
          if (/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) return;
          function send(path) {
            try {
              var body = JSON.stringify({ path: path, ref: document.referrer });
              navigator.sendBeacon(api + '/api/track', new Blob([body], { type: 'text/plain' }));
            } catch (e) {}
          }
          send(location.pathname);
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest && e.target.closest('a[data-track]');
            if (a) send(a.getAttribute('data-track'));
          });
        })();
      </script>
    )}

    <script>
      const root = document.documentElement
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try { localStorage.setItem('theme', next) } catch {}
      })

      type Item = { t: string; h: string; k?: string }
      const dlg = document.getElementById('cmdk') as HTMLDialogElement
      const input = document.getElementById('cmdk-input') as HTMLInputElement
      const list = document.getElementById('cmdk-list') as HTMLUListElement
      const items: Item[] = JSON.parse(document.getElementById('cmdk-data')!.textContent || '[]')
      let shown = items
      let active = 0

      function render() {
        list.innerHTML = ''
        if (!shown.length) {
          list.innerHTML = '<li class="none">Nothing matches that search.</li>'
          return
        }
        shown.forEach((it, i) => {
          const li = document.createElement('li')
          if (i === active) li.className = 'on'
          const a = document.createElement('a')
          a.href = it.h
          a.textContent = it.t
          if (it.k) {
            const s = document.createElement('small')
            s.textContent = it.k
            a.append(s)
          }
          li.append(a)
          list.append(li)
        })
        list.children[active]?.scrollIntoView({ block: 'nearest' })
      }
      function open() {
        if (dlg.open) return
        shown = items; active = 0; input.value = ''
        render(); dlg.showModal(); input.focus()
      }
      document.getElementById('cmdk-open')?.addEventListener('click', open)
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open() }
      })
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close() })
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase()
        shown = q ? items.filter((i) => i.t.toLowerCase().includes(q)) : items
        active = 0
        render()
      })
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, shown.length - 1); render() }
        else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); render() }
        else if (e.key === 'Enter' && shown[active]) { location.href = shown[active].h }
      })
    </script>
  </body>
</html>
